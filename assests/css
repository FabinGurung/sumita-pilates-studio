:root {
  --ink: #173d2d;
  --ink-2: #244e3a;
  --cream: #f8f5ee;
  --paper: #fffdf9;
  --sage: #dfe9e2;
  --sage-2: #eef4f0;
  --gold: #c59f55;
  --gold-soft: #efe0b9;
  --pink: #d987b5;
  --pink-soft: #f4dce8;
  --teal: #148f91;
  --teal-soft: #d9eeee;
  --blue: #397aa0;
  --blue-soft: #dceaf2;
  --yellow: #e5bd55;
  --yellow-soft: #f7edcc;
  --danger: #b83b34;
  --danger-soft: #fae7e4;
  --muted: #66736d;
  --line: #d7dfda;
  --shadow: 0 18px 50px rgba(23, 61, 45, 0.10);
  --shadow-sm: 0 8px 26px rgba(23, 61, 45, 0.09);
  --radius: 24px;
  --radius-sm: 15px;
  --max: 1180px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  background: var(--paper);
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
body.modal-open { overflow: hidden; }
img, svg { max-width: 100%; display: block; }
a { color: inherit; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }

.skip-link {
  position: absolute; left: 12px; top: -80px; z-index: 2000;
  background: var(--ink); color: white; padding: 10px 14px; border-radius: 8px;
}
.skip-link:focus { top: 12px; }

.container { width: min(var(--max), calc(100% - 36px)); margin: 0 auto; }
.narrow { width: min(820px, calc(100% - 36px)); margin: 0 auto; }
.section { padding: 82px 0; }
.section.compact { padding: 52px 0; }
.section.sage { background: var(--sage-2); }
.section.cream { background: var(--cream); }
.section.dark { background: var(--ink); color: white; }

.announcement {
  background: var(--ink); color: #fff; text-align: center; padding: 9px 44px;
  font-size: 0.87rem; letter-spacing: 0.02em; position: relative;
}
.announcement button {
  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
  border: 0; background: transparent; color: white; font-size: 1.25rem; padding: 6px;
}

.site-header {
  position: sticky; top: 0; z-index: 1000; background: rgba(255,253,249,.95);
  backdrop-filter: blur(14px); border-bottom: 1px solid rgba(215,223,218,.8);
}
.nav-shell { height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; min-width: 225px; }
.brand img { width: 44px; height: 44px; }
.brand-copy { display: grid; line-height: 1.05; }
.brand-copy strong { font-family: Georgia, "Times New Roman", serif; font-size: 1.18rem; letter-spacing: .01em; }
.brand-copy span { font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .13em; margin-top: 5px; }
.desktop-nav { display: flex; gap: 4px; align-items: center; }
.desktop-nav a { text-decoration: none; padding: 10px 12px; border-radius: 999px; font-size: .92rem; font-weight: 650; }
.desktop-nav a:hover, .desktop-nav a[aria-current="page"] { background: var(--sage); }
.nav-actions { display: flex; gap: 10px; align-items: center; }
.menu-button {
  display: none; width: 45px; height: 45px; border-radius: 50%; border: 1px solid var(--line);
  background: white; color: var(--ink); align-items: center; justify-content: center;
}
.menu-lines, .menu-lines::before, .menu-lines::after {
  display: block; width: 20px; height: 2px; background: currentColor; border-radius: 2px; position: relative;
}
.menu-lines::before, .menu-lines::after { content: ""; position: absolute; left: 0; }
.menu-lines::before { top: -6px; }
.menu-lines::after { top: 6px; }

.button {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 46px; padding: 11px 20px; border-radius: 999px; border: 1px solid transparent;
  text-decoration: none; font-weight: 750; transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
}
.button:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }
.button.primary { background: var(--teal); color: white; }
.button.ink { background: var(--ink); color: white; }
.button.light { background: white; color: var(--ink); border-color: var(--line); }
.button.ghost { background: transparent; border-color: rgba(255,255,255,.5); color: white; }
.button.small { min-height: 38px; padding: 8px 14px; font-size: .88rem; }
.button.danger { background: var(--danger); color: white; }
.button:disabled { opacity: .52; cursor: not-allowed; transform: none; box-shadow: none; }

.drawer-backdrop { position: fixed; inset: 0; z-index: 1190; background: rgba(9,32,24,.42); opacity: 0; pointer-events: none; transition: opacity .25s; }
.drawer { position: fixed; z-index: 1200; right: 0; top: 0; bottom: 0; width: min(390px, 90vw); background: var(--ink); color: white; transform: translateX(102%); transition: transform .28s ease; box-shadow: -25px 0 70px rgba(0,0,0,.25); padding: 22px; display: flex; flex-direction: column; }
.drawer.open { transform: translateX(0); }
.drawer-backdrop.open { opacity: 1; pointer-events: auto; }
.drawer-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,.18); }
.drawer-close { border: 1px solid rgba(255,255,255,.35); background: transparent; color: white; width: 42px; height: 42px; border-radius: 50%; font-size: 1.5rem; }
.drawer-links { display: grid; margin-top: 18px; }
.drawer-links a { color: white; text-decoration: none; font-size: 1.2rem; font-weight: 650; padding: 15px 8px; border-bottom: 1px solid rgba(255,255,255,.13); }
.drawer-actions { margin-top: auto; display: grid; gap: 12px; padding-top: 20px; }

.prototype-ribbon {
  position: fixed; left: -42px; top: 145px; z-index: 900; transform: rotate(-45deg);
  background: var(--gold); color: #1f2c25; font-size: .68rem; font-weight: 900; letter-spacing: .12em;
  padding: 7px 52px; box-shadow: var(--shadow-sm); pointer-events: none;
}

.hero { padding: 68px 0 76px; overflow: hidden; background: linear-gradient(140deg, #fffdf9 0%, #f6f0e6 60%, #eef4f0 100%); }
.hero-grid { display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: 58px; }
.eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--teal); font-weight: 850; text-transform: uppercase; letter-spacing: .13em; font-size: .74rem; }
.eyebrow::before { content: ""; width: 28px; height: 2px; background: currentColor; }
h1, h2, h3 { margin: 0; line-height: 1.08; }
h1 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.75rem, 5.5vw, 5.5rem); font-weight: 500; letter-spacing: -.045em; margin-top: 18px; }
h2 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.1rem, 4vw, 3.55rem); font-weight: 500; letter-spacing: -.035em; }
h3 { font-size: 1.2rem; }
.lead { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: #4c5d55; max-width: 650px; margin: 24px 0 0; }
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 26px; font-size: .88rem; color: var(--muted); }
.hero-meta span { display: inline-flex; gap: 7px; align-items: center; }
.hero-visual { position: relative; }
.hero-visual img { border-radius: 36px; box-shadow: var(--shadow); }
.floating-card { position: absolute; border-radius: 18px; background: rgba(255,255,255,.96); box-shadow: var(--shadow-sm); padding: 15px 18px; max-width: 220px; }
.floating-card strong { display: block; font-size: 1.05rem; }
.floating-card span { color: var(--muted); font-size: .82rem; }
.floating-card.top { top: 24px; right: -16px; }
.floating-card.bottom { left: -30px; bottom: 22px; }

.section-head { display: flex; align-items: end; justify-content: space-between; gap: 26px; margin-bottom: 36px; }
.section-head p { max-width: 600px; color: var(--muted); margin: 12px 0 0; }
.kicker { color: var(--teal); font-weight: 850; text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; margin-bottom: 10px; }

.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.feature-card { background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; box-shadow: 0 8px 20px rgba(23,61,45,.04); }
.feature-icon { width: 48px; height: 48px; border-radius: 15px; display: grid; place-items: center; background: var(--sage); font-size: 1.3rem; margin-bottom: 22px; }
.feature-card p { color: var(--muted); margin: 10px 0 0; font-size: .94rem; }

.split { display: grid; grid-template-columns: 1fr 1fr; gap: 58px; align-items: center; }
.story-card { padding: 34px; background: white; border-radius: var(--radius); box-shadow: var(--shadow-sm); border: 1px solid var(--line); }
.story-card p { color: var(--muted); }
.check-list { display: grid; gap: 12px; padding: 0; margin: 24px 0 0; list-style: none; }
.check-list li { display: flex; gap: 11px; align-items: flex-start; }
.check-list li::before { content: "✓"; display: grid; place-items: center; width: 23px; height: 23px; flex: 0 0 23px; border-radius: 50%; background: var(--sage); font-size: .78rem; font-weight: 900; }

.journey-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: journey; }
.journey-card { position: relative; padding: 28px 24px; background: white; border: 1px solid var(--line); border-radius: var(--radius); }
.journey-step { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: white; font-weight: 900; margin-bottom: 20px; }
.journey-card p { color: var(--muted); margin: 9px 0 0; }

.schedule-preview, .schedule-list { display: grid; gap: 16px; }
.day-group { display: grid; gap: 12px; margin-bottom: 26px; }
.day-heading { display: flex; align-items: baseline; gap: 10px; margin: 10px 0 2px; }
.day-heading h3 { font-family: Georgia, "Times New Roman", serif; font-size: 1.75rem; font-weight: 500; }
.day-heading span { color: var(--muted); font-weight: 650; }
.class-card {
  position: relative; display: grid; grid-template-columns: 92px 1fr auto; gap: 18px; align-items: center;
  background: white; border: 1px solid var(--line); border-radius: 20px; padding: 20px 22px 20px 27px; overflow: hidden;
  box-shadow: 0 6px 18px rgba(23,61,45,.04);
}
.class-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 8px; background: var(--pink); }
.class-card.accent-teal::before { background: var(--teal); }
.class-card.accent-blue::before { background: var(--blue); }
.class-card.accent-yellow::before { background: var(--yellow); }
.class-time strong { display: block; font-size: 1.25rem; }
.class-time span { color: var(--muted); font-size: .8rem; }
.class-main h3 { color: var(--blue); font-size: 1.1rem; margin-bottom: 6px; }
.class-meta { display: flex; gap: 13px; flex-wrap: wrap; color: var(--muted); font-size: .86rem; }
.class-right { display: flex; align-items: center; gap: 14px; }
.avatar { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: var(--sage); color: var(--ink); font-weight: 900; border: 3px solid var(--pink); }
.spot-badge { display: inline-flex; padding: 5px 9px; border-radius: 8px; background: var(--sage); color: var(--ink); font-size: .72rem; font-weight: 900; text-transform: uppercase; letter-spacing: .03em; margin-top: 9px; }
.spot-badge.low { background: var(--yellow-soft); }
.spot-badge.full { background: var(--teal); color: white; }
.class-action { min-width: 112px; }

.filters { display: grid; grid-template-columns: repeat(3, 1fr) auto; gap: 12px; background: var(--cream); border: 1px solid var(--line); border-radius: 20px; padding: 16px; margin-bottom: 34px; }
.field { display: grid; gap: 7px; }
.field label { font-size: .8rem; font-weight: 800; color: var(--muted); }
.field input, .field select, .field textarea {
  width: 100%; border: 1px solid #cbd6d0; background: white; color: var(--ink); border-radius: 12px; padding: 12px 13px; min-height: 45px;
}
.field textarea { min-height: 120px; resize: vertical; }
.field input:focus, .field select:focus, .field textarea:focus { outline: 3px solid rgba(20,143,145,.14); border-color: var(--teal); }
.field .hint { font-size: .78rem; color: var(--muted); }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-grid .full { grid-column: 1 / -1; }

.pass-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.pass-card { display: flex; flex-direction: column; background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; position: relative; overflow: hidden; }
.pass-card.featured { border-color: var(--gold); box-shadow: 0 16px 36px rgba(197,159,85,.18); }
.pass-badge { align-self: flex-start; background: var(--gold-soft); border-radius: 999px; padding: 5px 10px; font-size: .72rem; font-weight: 900; text-transform: uppercase; letter-spacing: .05em; }
.pass-price { font-family: Georgia, "Times New Roman", serif; font-size: 2.35rem; margin-top: 17px; }
.pass-price small { font-family: inherit; font-size: .9rem; color: var(--muted); }
.pass-card p { color: var(--muted); }
.pass-card ul { list-style: none; padding: 0; display: grid; gap: 10px; margin: 18px 0 26px; }
.pass-card li::before { content: "✓"; margin-right: 9px; font-weight: 900; color: var(--teal); }
.pass-card .button { margin-top: auto; }

.instructor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.instructor-card { background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
.instructor-portrait { width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; font-family: Georgia, serif; font-size: 1.7rem; background: var(--sage); border: 4px solid var(--pink); margin-bottom: 20px; }
.instructor-role { color: var(--teal); font-weight: 800; font-size: .85rem; margin-top: 6px; }
.instructor-card p { color: var(--muted); }
.tag-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
.tag { padding: 6px 10px; background: var(--sage-2); border-radius: 999px; font-size: .75rem; font-weight: 750; }

.testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.quote-card { background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
.quote-card blockquote { font-family: Georgia, serif; font-size: 1.25rem; margin: 0 0 22px; line-height: 1.4; }
.quote-card strong { display: block; }
.quote-card span { color: var(--muted); font-size: .85rem; }

.cta-panel { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px; padding: 42px; background: var(--ink); color: white; border-radius: 30px; }
.cta-panel p { color: rgba(255,255,255,.75); max-width: 650px; margin: 12px 0 0; }

.page-hero { padding: 64px 0 42px; background: linear-gradient(135deg, var(--cream), var(--sage-2)); }
.page-hero p { color: var(--muted); max-width: 720px; font-size: 1.08rem; margin: 17px 0 0; }
.breadcrumb { display: inline-flex; gap: 8px; align-items: center; font-size: .82rem; color: var(--muted); margin-bottom: 14px; }
.breadcrumb a { text-decoration: none; }

.notice { border: 1px solid var(--gold); background: #fff8e7; border-radius: 15px; padding: 14px 16px; color: #71591f; }
.notice.danger { border-color: #e6afa9; background: var(--danger-soft); color: #842e29; }
.notice.success { border-color: #b8d8c7; background: var(--sage-2); color: var(--ink); }
.empty-state { text-align: center; padding: 48px 22px; background: var(--cream); border-radius: var(--radius); border: 1px dashed #c9d2cd; }
.empty-state p { color: var(--muted); }

.member-shell { display: grid; grid-template-columns: 280px 1fr; gap: 28px; align-items: start; }
.member-sidebar { position: sticky; top: 104px; background: var(--ink); color: white; border-radius: var(--radius); padding: 24px; }
.member-sidebar .member-avatar { width: 66px; height: 66px; border-radius: 50%; background: var(--pink); color: var(--ink); display: grid; place-items: center; font-weight: 900; font-size: 1.1rem; }
.member-sidebar p { color: rgba(255,255,255,.7); font-size: .88rem; }
.member-nav { display: grid; gap: 8px; margin-top: 24px; }
.member-nav button { border: 0; text-align: left; border-radius: 11px; padding: 11px 12px; background: transparent; color: white; }
.member-nav button.active, .member-nav button:hover { background: rgba(255,255,255,.13); }
.dashboard-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
.metric-card { background: white; border: 1px solid var(--line); border-radius: 19px; padding: 22px; }
.metric-card .metric-label { color: var(--muted); font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
.metric-card .metric-value { font-family: Georgia, serif; font-size: 2rem; margin-top: 7px; }
.dashboard-panel { margin-top: 20px; background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; }
.dashboard-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 20px; }
.progress-bars { display: grid; gap: 14px; }
.progress-row { display: grid; grid-template-columns: 120px 1fr 42px; align-items: center; gap: 12px; }
.progress-track { height: 11px; background: var(--sage); border-radius: 999px; overflow: hidden; }
.progress-track span { display: block; height: 100%; background: var(--teal); border-radius: inherit; }
.reservation-list { display: grid; gap: 12px; }
.reservation-item { display: grid; grid-template-columns: 70px 1fr auto; gap: 15px; align-items: center; padding: 15px; border: 1px solid var(--line); border-radius: 15px; }

.auth-card { max-width: 620px; margin: 0 auto; background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow-sm); }
.auth-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: var(--sage-2); border-radius: 13px; padding: 5px; margin-bottom: 22px; }
.auth-tabs button { border: 0; padding: 11px; border-radius: 10px; background: transparent; color: var(--ink); font-weight: 800; }
.auth-tabs button.active { background: white; box-shadow: 0 4px 12px rgba(23,61,45,.08); }

.modal-backdrop { position: fixed; inset: 0; z-index: 2000; background: rgba(9,32,24,.55); display: none; place-items: center; padding: 18px; }
.modal-backdrop.open { display: grid; }
.modal { width: min(610px, 100%); max-height: 92vh; overflow: auto; background: white; border-radius: 24px; box-shadow: 0 32px 90px rgba(0,0,0,.3); }
.modal-head { padding: 22px 24px; display: flex; justify-content: space-between; align-items: start; border-bottom: 1px solid var(--line); }
.modal-head p { margin: 6px 0 0; color: var(--muted); }
.modal-close { width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 50%; background: white; font-size: 1.3rem; }
.modal-body { padding: 24px; }
.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }

.faq-list { display: grid; gap: 12px; }
.faq-item { border: 1px solid var(--line); border-radius: 16px; background: white; overflow: hidden; }
.faq-item button { width: 100%; border: 0; background: white; color: var(--ink); padding: 18px 20px; display: flex; justify-content: space-between; text-align: left; font-weight: 800; }
.faq-answer { display: none; padding: 0 20px 20px; color: var(--muted); }
.faq-item.open .faq-answer { display: block; }

.contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 30px; }
.contact-card { background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
.contact-list { display: grid; gap: 16px; margin-top: 24px; }
.contact-list a { text-decoration: none; color: var(--teal); font-weight: 800; }
.map-placeholder { min-height: 390px; border-radius: var(--radius); background: linear-gradient(145deg, var(--sage), var(--gold-soft)); display: grid; place-items: center; padding: 30px; text-align: center; }
.map-dot { width: 76px; height: 76px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--ink); display: grid; place-items: center; margin: 0 auto 26px; }
.map-dot span { transform: rotate(45deg); color: white; font-weight: 900; }

.editor-layout { display: grid; grid-template-columns: 260px 1fr; gap: 24px; }
.editor-nav { background: var(--ink); color: white; border-radius: var(--radius); padding: 18px; align-self: start; position: sticky; top: 100px; }
.editor-nav button { width: 100%; text-align: left; border: 0; background: transparent; color: white; padding: 12px; border-radius: 10px; }
.editor-nav button.active { background: rgba(255,255,255,.14); }
.editor-panel { background: white; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; }
.editor-table { width: 100%; border-collapse: collapse; font-size: .86rem; }
.editor-table th, .editor-table td { border-bottom: 1px solid var(--line); text-align: left; padding: 10px; vertical-align: top; }
.editor-table input, .editor-table select { width: 100%; min-width: 100px; border: 1px solid var(--line); border-radius: 8px; padding: 8px; }

.site-footer { padding: 56px 0 28px; background: #103126; color: white; }
.footer-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 38px; }
.footer-brand { max-width: 360px; }
.footer-brand p { color: rgba(255,255,255,.67); }
.footer-column h3 { font-size: .86rem; text-transform: uppercase; letter-spacing: .1em; color: var(--gold-soft); margin-bottom: 15px; }
.footer-column a, .footer-column span { display: block; color: rgba(255,255,255,.72); text-decoration: none; margin: 9px 0; font-size: .9rem; }
.footer-bottom { display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid rgba(255,255,255,.14); padding-top: 22px; margin-top: 34px; color: rgba(255,255,255,.55); font-size: .78rem; }

.reveal { opacity: 0; transform: translateY(16px); transition: opacity .5s ease, transform .5s ease; }
.reveal.visible { opacity: 1; transform: none; }

@media (max-width: 1020px) {
  .desktop-nav, .nav-actions .member-button { display: none; }
  .menu-button { display: inline-flex; }
  .hero-grid, .split, .contact-grid { grid-template-columns: 1fr; }
  .hero-visual { max-width: 720px; margin: 0 auto; }
  .feature-grid, .journey-grid { grid-template-columns: repeat(2, 1fr); }
  .pass-grid, .instructor-grid, .testimonial-grid { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; }
  .footer-grid .footer-column:last-child { grid-column: 2 / -1; }
  .member-shell { grid-template-columns: 1fr; }
  .member-sidebar { position: static; }
  .dashboard-grid { grid-template-columns: repeat(2, 1fr); }
  .editor-layout { grid-template-columns: 1fr; }
  .editor-nav { position: static; display: flex; flex-wrap: wrap; }
  .editor-nav button { width: auto; }
}

@media (max-width: 720px) {
  .container, .narrow { width: min(100% - 24px, var(--max)); }
  .announcement { text-align: left; padding-left: 14px; }
  .nav-shell { height: 69px; }
  .brand { min-width: 0; }
  .brand img { width: 39px; height: 39px; }
  .brand-copy strong { font-size: 1rem; }
  .brand-copy span { display: none; }
  .nav-actions .book-button { display: none; }
  .section { padding: 60px 0; }
  .hero { padding: 48px 0 58px; }
  h1 { font-size: clamp(2.55rem, 13vw, 4rem); }
  .floating-card.top { right: 4px; top: 10px; }
  .floating-card.bottom { left: 4px; bottom: 10px; }
  .section-head { display: block; }
  .feature-grid, .journey-grid, .pass-grid, .instructor-grid, .testimonial-grid, .footer-grid { grid-template-columns: 1fr; }
  .footer-grid .footer-column:last-child { grid-column: auto; }
  .class-card { grid-template-columns: 68px 1fr; gap: 12px; padding: 17px 16px 17px 22px; }
  .class-right { grid-column: 1 / -1; justify-content: space-between; padding-left: 68px; }
  .class-action { min-width: 132px; }
  .filters { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
  .form-grid .full { grid-column: auto; }
  .cta-panel { grid-template-columns: 1fr; padding: 30px 24px; }
  .dashboard-grid { grid-template-columns: 1fr 1fr; }
  .progress-row { grid-template-columns: 90px 1fr 36px; }
  .reservation-item { grid-template-columns: 55px 1fr; }
  .reservation-item .reservation-actions { grid-column: 1 / -1; }
  .footer-bottom { display: block; }
  .prototype-ribbon { display: none; }
}

@media (max-width: 430px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .hero-actions .button { width: 100%; }
  .class-right { padding-left: 0; }
  .avatar { width: 46px; height: 46px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
}
